# Fichier d'exemple des variables d'environnement pour docker-compose
# Copiez ce fichier vers `.env` et personnalisez les valeurs avant de lancer

# MySQL
MYSQL_ROOT_PASSWORD=changez_moi_root
MYSQL_DATABASE=contacts_db
MYSQL_USER=contacts_user
MYSQL_PASSWORD=changez_moi_dbpass

# Backend / Frontend
# URL publique du frontend (pour CORS dans PHP)
FRONTEND_URL=http://localhost:3000

# URL de base de l'API utilisée par le frontend (build-time arg pour Vite)
API_BASE_URL=http://localhost:8080/api
